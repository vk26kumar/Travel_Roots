  <div class="container-xl">
    <div class="row g-4">
      <div class="col-lg-4 pe-lg-5">
        <a class="brand" href="/listings">
          <span class="brand-mark" aria-hidden="true"><%- helpers.icon("sprout") %></span>
          <span>Travel Roots</span>
        </a>
        <p class="footer-statement">Stays with a story, from hosts who know their place.</p>
        <div class="social">
          <a href="https://github.com/vk26kumar" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><%- helpers.icon("github") %></a>
          <a href="https://www.linkedin.com/in/vishal-kumar2606/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><%- helpers.icon("linkedin") %></a>
          <a href="https://www.instagram.com/vk.vishal_jaiswal/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><%- helpers.icon("instagram") %></a>
        </div>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <h2>Explore</h2>
        <ul>
          <li><a href="/listings">All stays</a></li>
          <li><a href="/listings?category=Trending">Trending</a></li>
          <li><a href="/listings?category=Mountain">Mountains</a></li>
          <li><a href="/listings?category=Camping">Camping</a></li>
          <li><a href="/listings?sort=rating">Top rated</a></li>
        </ul>
