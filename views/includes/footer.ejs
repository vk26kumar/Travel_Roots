        <ul>
          <li><a href="mailto:<%= supportEmail %>">Contact support</a></li>
          <li><a href="/profile?tab=trips">Your trips</a></li>
          <li><a href="/forgot-password">Reset password</a></li>
          <li><a href="/terms#payments">Payments</a></li>
