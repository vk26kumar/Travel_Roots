<%# Partials read include data directly: ejs-mate shadows `locals` with its own object. %>
<%
  const values = (typeof listing !== "undefined" && listing) || {};
  const isEdit = Boolean(values._id);
  const action = isEdit ? `/listings/${values._id}?_method=PUT` : "/listings";
%>
<% if (!features.uploads) { %>
<div class="callout mb-4">
  <%- helpers.icon("alert") %>
  <div>Image uploads are not configured on this server, so new photos cannot be saved right now.</div>
</div>
<% } %>

<form method="POST" action="<%= action %>" class="needs-validation" enctype="multipart/form-data" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />

  <section class="surface panel">
    <h2>The basics</h2>
    <p class="panel-intro">A clear title and an honest description help guests choose your place.</p>

    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input id="title" name="listing[title]" type="text" class="form-control" value="<%= values.title || '' %>" placeholder="Sunlit cottage with a mountain view" minlength="3" maxlength="100" required />
      <div class="invalid-feedback">Please enter a title between 3 and 100 characters.</div>
    </div>

    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="listing[description]" rows="6" class="form-control" minlength="10" maxlength="2000" placeholder="Describe the space, the neighbourhood and what makes it special." required><%= values.description || '' %></textarea>
      <div class="invalid-feedback">Please write a description of at least 10 characters.</div>
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <label for="category" class="form-label">Category</label>
        <select id="category" name="listing[category]" class="form-select" required>
          <option value="" disabled <%= values.category ? "" : "selected" %>>Choose a category</option>
          <% for (const item of categories) { %>
          <option value="<%= item.name %>" <%= values.category === item.name ? "selected" : "" %>><%= item.name %></option>
          <% } %>
        </select>
        <div class="invalid-feedback">Please choose a category.</div>
      </div>
      <div class="col-md-6">
        <label for="price" class="form-label">Price per night (INR)</label>
        <div class="input-group has-validation">
          <span class="input-group-text">&#8377;</span>
          <input id="price" name="listing[price]" type="number" class="form-control" value="<%= values.price || '' %>" min="1" max="1000000" step="1" inputmode="numeric" required />
          <div class="invalid-feedback">Enter a whole number between 1 and 10,00,000.</div>
        </div>
        <div class="form-hint">GST of <%= Math.round(taxRate * 100) %>% is added for guests at checkout.</div>
      </div>
    </div>
  </section>

  <section class="surface panel">
    <h2>Location</h2>
    <p class="panel-intro">Guests see the area on a map. The exact address is not shown publicly.</p>
    <div class="row g-3">
      <div class="col-md-6">
        <label for="location" class="form-label">City or area</label>
        <input id="location" name="listing[location]" type="text" class="form-control" value="<%= values.location || '' %>" placeholder="Manali" minlength="2" maxlength="100" required />
        <div class="invalid-feedback">Please enter a location.</div>
      </div>
      <div class="col-md-6">
        <label for="country" class="form-label">Country</label>
        <input id="country" name="listing[country]" type="text" class="form-control" value="<%= values.country || '' %>" placeholder="India" minlength="2" maxlength="60" required />
        <div class="invalid-feedback">Please enter a country.</div>
      </div>
    </div>
  </section>

  <section class="surface panel">
    <h2>Photo</h2>
    <p class="panel-intro">Landscape photos work best. Photos are stored and served as optimised WebP images.</p>
    <% if (isEdit && values.image && values.image.url) { %>
    <p class="small text-muted mb-2">Current photo</p>
    <img class="image-preview mb-3" src="<%= helpers.imageUrl(values.image.url, { width: 720, height: 540 }) %>" alt="Current photo of <%= values.title %>" />
    <% } %>
    <label for="image" class="form-label"><%= isEdit ? "Replace photo (optional)" : "Upload a photo" %></label>
    <input id="image" name="listing[image]" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" data-preview="imagePreview" <%= isEdit ? "" : "required" %> />
    <div class="invalid-feedback">Please choose a JPG, PNG or WebP image up to 5 MB.</div>
    <div class="form-hint">JPG, PNG or WebP, up to 5 MB.</div>
    <img id="imagePreview" class="image-preview mt-3" alt="Preview of the selected photo" hidden />
  </section>

  <section class="surface panel">
    <h2>Contact details</h2>
    <p class="panel-intro">Shown to signed-in guests on the booking page.</p>
    <div class="row g-3">
      <div class="col-md-6">
        <label for="phone" class="form-label">Phone number</label>
        <input id="phone" name="listing[phone]" type="tel" class="form-control" value="<%= values.phone || '' %>" placeholder="+91 98765 43210" pattern="\+?[0-9\s\-]{7,20}" required />
        <div class="invalid-feedback">Enter a valid phone number.</div>
      </div>
      <div class="col-md-6">
        <label for="email" class="form-label">Email</label>
        <input id="email" name="listing[email]" type="email" class="form-control" value="<%= values.email || (currUser && currUser.email) || '' %>" maxlength="254" required />
        <div class="invalid-feedback">Enter a valid email address.</div>
      </div>
    </div>
  </section>

  <% if (!isEdit) { %>
  <div class="form-check my-4">
    <input class="form-check-input" type="checkbox" value="accepted" id="terms" name="terms" required />
    <label class="form-check-label" for="terms">
      I confirm I am allowed to host this place and agree to the <a href="/terms#hosts" target="_blank">host terms</a>.
    </label>
    <div class="invalid-feedback">You must agree before publishing.</div>
  </div>
  <% } %>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <button type="submit" class="btn btn-primary btn-lg" data-loading-text="<%= isEdit ? 'Saving...' : 'Publishing...' %>"><%= isEdit ? "Save changes" : "Publish listing" %></button>
    <a href="<%= isEdit ? `/listings/${values._id}` : '/listings' %>" class="btn btn-outline btn-lg">Cancel</a>
  </div>
</form>
