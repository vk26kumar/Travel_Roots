<%
  const isActive = (prefix) => currentPath === prefix || currentPath.startsWith(`${prefix}/`);
  const themeToggle = `<button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="Toggle dark mode">${helpers.icon("moon", { className: "theme-icon-moon" })}${helpers.icon("sun", { className: "theme-icon-sun" })}</button>`;
%>
<header class="site-header">
  <nav class="navbar navbar-expand-lg" aria-label="Primary">
    <div class="container-xl gap-3">
      <a class="brand" href="/listings" aria-label="Travel Roots home">
        <img class="brand-logo" src="<%= helpers.asset('/images/logo.svg') %>" width="36" height="36" alt="" />
        <span>Travel Roots</span>
      </a>

      <div class="d-flex align-items-center gap-1 d-lg-none">
        <%- themeToggle %>
        <button
          class="btn btn-ghost btn-icon nav-toggler"
          type="button"
          data-collapse="#primaryNav"
          aria-controls="primaryNav"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <%- helpers.icon("menu") %>
        </button>
      </div>

      <div class="collapse navbar-collapse gap-3" id="primaryNav">
        <ul class="nav-links">
          <li><a class="nav-link-item <%= currentPath === '/listings' ? 'active' : '' %>" href="/listings" <%- currentPath === '/listings' ? 'aria-current="page"' : '' %>>Explore</a></li>
          <li><a class="nav-link-item <%= isActive('/listings/new') ? 'active' : '' %>" href="/listings/new">Host your place</a></li>
        </ul>

        <form class="header-search ms-lg-auto" role="search" action="/listings" method="GET">
          <label for="navSearch" class="visually-hidden">Search destinations</label>
          <%- helpers.icon("search") %>
          <input id="navSearch" type="search" name="search" placeholder="Search a city, country or stay" value="<%= searchQuery %>" autocomplete="off" maxlength="100" />
        </form>

        <div class="d-flex align-items-center gap-2">
          <span class="d-none d-lg-inline-flex"><%- themeToggle %></span>
          <% if (currUser) { %>
          <div class="menu">
            <button class="menu-toggle" type="button" data-menu="accountMenu" aria-expanded="false" aria-controls="accountMenu" aria-label="Account menu">
              <%- include("avatar", { user: currUser, size: "sm", decorative: true }) %>
              <span class="small fw-semibold d-lg-none"><%= currUser.displayName || currUser.username %></span>
              <%- helpers.icon("chevron-down") %>
            </button>
            <div class="menu-panel" id="accountMenu" hidden>
              <div class="menu-header">
                <div class="fw-semibold text-truncate"><%= currUser.displayName || currUser.username %></div>
                <div class="small text-muted text-truncate"><%= currUser.email %></div>
              </div>
              <a class="menu-item" href="/profile"><%- helpers.icon("user") %>Profile</a>
              <a class="menu-item" href="/profile?tab=trips"><%- helpers.icon("luggage") %>Trips</a>
              <a class="menu-item" href="/profile?tab=saved"><%- helpers.icon("heart") %>Saved stays</a>
              <a class="menu-item" href="/profile?tab=listings"><%- helpers.icon("house") %>Your listings</a>
              <a class="menu-item" href="/profile?tab=hosting"><%- helpers.icon("calendar-check") %>Reservations</a>
              <a class="menu-item" href="/profile/settings"><%- helpers.icon("settings") %>Account settings</a>
              <div class="menu-divider"></div>
              <form action="/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                <button class="menu-item" type="submit"><%- helpers.icon("log-out") %>Sign out</button>
              </form>
            </div>
          </div>
          <% } else { %>
          <a class="btn btn-ghost" href="/login">Sign in</a>
          <a class="btn btn-primary" href="/signup">Create account</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
