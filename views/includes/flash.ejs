<% if ((success && success.length) || (error && error.length)) { %>
<div class="flash-stack" aria-live="polite">
  <% for (const message of success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="status" data-autodismiss>
    <i class="fa-solid fa-circle-check mt-1" aria-hidden="true"></i>
    <div><%= message %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
  </div>
  <% } %>
  <% for (const message of error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-circle-exclamation mt-1" aria-hidden="true"></i>
    <div><%= message %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
  </div>
  <% } %>
</div>
<% } %>
