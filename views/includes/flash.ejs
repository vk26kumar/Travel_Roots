<% if ((success && success.length) || (error && error.length)) { %>
<div class="flash-stack" aria-live="polite">
  <% for (const message of success) { %>
  <div class="notice" role="status" data-notice data-autodismiss>
    <%- helpers.icon("circle-check") %>
    <div><%= message %></div>
    <button type="button" class="notice-close" data-dismiss aria-label="Dismiss"><%- helpers.icon("x") %></button>
  </div>
  <% } %>
  <% for (const message of error) { %>
  <div class="notice notice-error" role="alert" data-notice>
    <%- helpers.icon("circle-alert") %>
    <div><%= message %></div>
    <button type="button" class="notice-close" data-dismiss aria-label="Dismiss"><%- helpers.icon("x") %></button>
  </div>
  <% } %>
</div>
<% } %>
