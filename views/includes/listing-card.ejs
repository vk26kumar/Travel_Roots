<%# Partials read include data directly: ejs-mate shadows `locals` with its own object. %>
<%
  const card = listing;
  const cardId = card._id.toString();
  const isSaved = typeof saved !== "undefined" && saved && saved.has(cardId);
  const priceWithTax = Math.round(card.price * (1 + taxRate));
  const imageSrc = card.image && card.image.url;
  const kicker = !card.ratingCount ? "New" : card.ratingAverage >= 4.5 && card.ratingCount >= 2 ? "Guest favourite" : card.category;
  const eager = typeof eagerImage !== "undefined" && eagerImage;
%>
<article class="listing-card">
  <div class="listing-card-media">
    <img
      src="<%= helpers.imageUrl(imageSrc, { width: 600, height: 450 }) %>"
      srcset="<%= helpers.imageSrcset(imageSrc, [400, 600, 800], 4 / 3) %>"
      sizes="(min-width: 1200px) 290px, (min-width: 992px) 31vw, (min-width: 576px) 46vw, 92vw"
      alt="<%= card.title %>"
      width="600"
      height="450"
      <%- eager ? 'fetchpriority="high"' : 'loading="lazy"' %>
      decoding="async"
    />
  </div>

  <% if (currUser) { %>
  <button type="button" class="save-btn" data-wishlist-id="<%= cardId %>" aria-pressed="<%= isSaved ? 'true' : 'false' %>" aria-label="<%= isSaved ? 'Remove from saved stays' : 'Save to wishlist' %>">
    <%- helpers.icon("heart", { className: "icon-heart" }) %>
  </button>
  <% } else { %>
  <a class="save-btn" href="/login" aria-label="Sign in to save this stay"><%- helpers.icon("heart", { className: "icon-heart" }) %></a>
  <% } %>

  <div class="listing-card-body">
    <span class="listing-card-kicker"><%= kicker %></span>
    <div class="d-flex justify-content-between align-items-start gap-2">
      <h3 class="listing-card-title text-truncate">
        <a href="/listings/<%= cardId %>"><%= helpers.placeName(card.location, card.country) %></a>
      </h3>
      <% if (card.ratingCount > 0) { %>
      <span class="rating"><%- helpers.icon("star") %><%= card.ratingAverage.toFixed(1) %><span class="visually-hidden"> out of 5 from <%= card.ratingCount %> reviews</span></span>
      <% } %>
    </div>
    <p class="listing-card-subtitle"><%= card.title %></p>
    <p class="listing-card-price">
      <span class="tax-hide"><strong><%= helpers.formatINR(card.price) %></strong> per night</span>
      <span class="tax-info"><strong><%= helpers.formatINR(priceWithTax) %></strong> per night incl. GST</span>
    </p>
  </div>
</article>
