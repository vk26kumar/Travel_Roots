<!doctype html>
<html lang="en-IN" data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title ? `${title} | Travel Roots` : "Travel Roots | Discover and book unique stays" %></title>
    <meta
      name="description"
      content="<%= description || 'Travel Roots helps you discover handpicked stays, connect with hosts and book securely online.' %>"
    />
    <meta name="theme-color" content="#e0364a" />
    <meta property="og:site_name" content="Travel Roots" />
    <meta property="og:title" content="<%= title || 'Travel Roots' %>" />
    <meta property="og:type" content="website" />
    <% if (currUser) { %>
    <meta name="csrf-token" content="<%= csrfToken() %>" />
    <% } %>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <script src="/js/theme.js?v=<%= assetVersion %>"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
    <%- block("head").toString() %>
    <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <%- include("../includes/navbar") %>

    <main id="main" class="site-main" tabindex="-1">
      <%- include("../includes/flash") %>
      <%- body %>
    </main>

    <%- include("../includes/footer") %>
    <%- include("../includes/cookie-banner") %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js?v=<%= assetVersion %>"></script>
    <script src="/js/app.js?v=<%= assetVersion %>"></script>
    <%- block("scripts").toString() %>
  </body>
</html>
