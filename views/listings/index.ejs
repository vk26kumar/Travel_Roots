<% layout("/layouts/boilerplate") %>
<%
  const buildQuery = (overrides) => {
    const params = new URLSearchParams();
    const values = Object.assign({ search, category, sort: sortKey === "recommended" ? "" : sortKey }, overrides);
    for (const [key, value] of Object.entries(values)) {
      if (value) params.set(key, value);
    }
    const query = params.toString();
    return query ? `/listings?${query}` : "/listings";
  };
%>

<div class="container-xl">
  <% if (isLanding) { %>
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-content">
      <span class="eyebrow text-white-50">Stays, experiences and memories</span>
      <h1 id="heroTitle">Find a stay that feels like home.</h1>
      <p class="lead">
        Explore handpicked cabins, villas, farm stays and city apartments from hosts around the world, then book
        securely in minutes.
      </p>
      <form class="hero-search" action="/listings" method="GET" role="search">
        <div>
          <label for="heroSearch" class="visually-hidden">Where are you going?</label>
          <input id="heroSearch" class="form-control form-control-lg" type="search" name="search" placeholder="Where are you going?" maxlength="100" />
        </div>
        <div>
          <label for="heroCategory" class="visually-hidden">Type of stay</label>
          <select id="heroCategory" class="form-select form-select-lg" name="category">
            <option value="">Any type of stay</option>
            <% for (const item of categories) { %>
            <option value="<%= item.name %>"><%= item.name %></option>
            <% } %>
          </select>
        </div>
        <button class="btn btn-brand btn-lg" type="submit">
          <i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>Search
        </button>
      </form>
    </div>
  </section>
  <% } else { %>
  <section class="pt-4">
    <a href="/listings" class="small text-decoration-none"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>All stays</a>
    <h1 class="h2 mt-2 mb-1">
      <% if (search && category) { %><%= category %> stays matching "<%= search %>"<% } else if (search) { %>Stays matching "<%= search %>"<% } else if (category) { %><%= category %> stays<% } else { %>Explore stays<% } %>
    </h1>
  </section>
  <% } %>

  <nav class="mt-4" aria-label="Categories">
    <div class="category-bar">
      <a class="category-chip <%= !category ? 'active' : '' %>" href="<%= buildQuery({ category: '', page: '' }) %>" <%- !category ? 'aria-current="true"' : '' %>>
        <i class="fa-solid fa-border-all" aria-hidden="true"></i> All
      </a>
      <% for (const item of categories) { %>
      <a class="category-chip <%= category === item.name ? 'active' : '' %>" href="<%= buildQuery({ category: item.name, page: '' }) %>" <%- category === item.name ? 'aria-current="true"' : '' %>>
        <i class="<%= item.icon %>" aria-hidden="true"></i> <%= item.name %>
      </a>
      <% } %>
    </div>
  </nav>

  <div class="toolbar">
    <p class="mb-0 text-muted" aria-live="polite">
      <strong class="text-body"><%= total %></strong> <%= total === 1 ? "stay" : "stays" %> found
      <% if (search || category) { %>&middot; <a href="/listings">Clear filters</a><% } %>
    </p>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="taxToggle" />
        <label class="form-check-label" for="taxToggle">Show prices incl. GST</label>
      </div>
      <form method="GET" action="/listings" class="d-flex align-items-center gap-2">
        <% if (search) { %><input type="hidden" name="search" value="<%= search %>" /><% } %>
        <% if (category) { %><input type="hidden" name="category" value="<%= category %>" /><% } %>
        <label for="sortSelect" class="small text-muted text-nowrap">Sort by</label>
        <select id="sortSelect" name="sort" class="form-select form-select-sm" data-auto-submit>
          <% for (const [key, option] of Object.entries(sortOptions)) { %>
          <option value="<%= key %>" <%= key === sortKey ? "selected" : "" %>><%= option.label %></option>
          <% } %>
        </select>
        <noscript><button class="btn btn-sm btn-quiet" type="submit">Apply</button></noscript>
      </form>
    </div>
  </div>

  <% if (listings.length) { %>
  <section aria-label="Stays">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
      <% for (const listing of listings) { %>
      <div class="col"><%- include("../includes/listing-card", { listing }) %></div>
      <% } %>
    </div>
  </section>

  <% if (totalPages > 1) { %>
  <nav class="mt-5" aria-label="Pagination">
    <ul class="pagination justify-content-center flex-wrap">
      <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="<%= buildQuery({ page: page - 1 > 1 ? page - 1 : '' }) %>" aria-label="Previous page">
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </a>
      </li>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <% if (p === 1 || p === totalPages || Math.abs(p - page) <= 1) { %>
        <li class="page-item <%= p === page ? 'active' : '' %>">
          <a class="page-link" href="<%= buildQuery({ page: p > 1 ? p : '' }) %>" <%- p === page ? 'aria-current="page"' : '' %>><%= p %></a>
        </li>
        <% } else if (Math.abs(p - page) === 2) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        <% } %>
      <% } %>
      <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="<%= buildQuery({ page: page < totalPages ? page + 1 : totalPages }) %>" aria-label="Next page">
          <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </a>
      </li>
    </ul>
  </nav>
  <% } %>
  <% } else { %>
  <div class="empty-state">
    <span class="empty-state-icon"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i></span>
    <h2 class="h4">No stays found</h2>
    <p class="text-muted mb-4">
      We could not find a stay matching your search. Try a different destination or browse every category.
    </p>
    <a href="/listings" class="btn btn-brand">Browse all stays</a>
  </div>
  <% } %>

  <% if (isLanding && destinations.length) { %>
  <section class="section" aria-labelledby="destinationsTitle">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Popular right now</span>
        <h2 id="destinationsTitle">Destinations travellers love</h2>
      </div>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
      <% for (const destination of destinations) { %>
      <div class="col">
        <a class="destination-card" href="/listings?search=<%= encodeURIComponent(destination._id) %>">
          <img src="<%= helpers.imageUrl(destination.image, { width: 400, height: 500 }) %>" alt="" loading="lazy" />
          <span class="destination-card-label">
            <strong><%= destination._id %></strong>
            <span class="small"><%= destination.count %> <%= destination.count === 1 ? "stay" : "stays" %></span>
          </span>
        </a>
      </div>
      <% } %>
    </div>
  </section>
  <% } %>

  <% if (isLanding) { %>
  <section class="section pt-0" aria-labelledby="whyTitle">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Why Travel Roots</span>
        <h2 id="whyTitle">Booking made simple and safe</h2>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="surface feature">
          <span class="feature-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
          <h3 class="h5">Secure payments</h3>
          <p class="text-muted mb-0">
            Payments are processed by Razorpay. Card details never touch our servers and every amount is verified
            on our side before a booking is confirmed.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="surface feature">
          <span class="feature-icon"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
          <h3 class="h5">Honest reviews</h3>
          <p class="text-muted mb-0">
            Ratings come from signed-in guests, one review per guest per stay, so you know what to expect before
            you arrive.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="surface feature">
          <span class="feature-icon"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span>
          <h3 class="h5">Hosts you can reach</h3>
          <p class="text-muted mb-0">
            Signed-in guests can see the host's contact details before booking, and every trip and receipt stays
            available in your profile.
          </p>
        </div>
      </div>
    </div>
  </section>

  <% if (stats && stats.stays) { %>
  <section class="surface-alt stats-strip mb-5" aria-label="Travel Roots in numbers">
    <div><strong><%= stats.stays.toLocaleString("en-IN") %></strong><span class="text-muted">Stays listed</span></div>
    <div><strong><%= stats.countries.toLocaleString("en-IN") %></strong><span class="text-muted">Countries</span></div>
    <div><strong><%= stats.hosts.toLocaleString("en-IN") %></strong><span class="text-muted">Hosts</span></div>
  </section>
  <% } %>

  <section class="cta-band" aria-labelledby="hostTitle">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <h2 id="hostTitle" class="h3">Have a place to share?</h2>
        <p class="mb-0">
          List your home, cabin or farm stay in a few minutes. You set the price, and guests pay securely online.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a class="btn btn-brand btn-lg" href="/listings/new">Become a host</a>
      </div>
    </div>
  </section>
  <% } %>
</div>
