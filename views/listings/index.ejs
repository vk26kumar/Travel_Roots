<% layout("/layouts/boilerplate") %>
<%
  const buildQuery = (overrides) => {
    const params = new URLSearchParams();
    const values = Object.assign({ search, category, sort: sortKey === "recommended" ? "" : sortKey }, overrides);
    for (const [key, value] of Object.entries(values)) {
      if (value) params.set(key, value);
    }
    const query = params.toString();
    return query ? `/listings?${query}` : "/listings";
  };
  const heroSrcset = ["640", "960", "1280"].map((w) => `${helpers.asset(`/images/hero-${w}.webp`)} ${w}w`).join(", ");
%>

<div class="container-xl">
  <% if (isLanding) { %>
  <section class="hero" aria-labelledby="heroTitle">
    <div>
      <span class="eyebrow">Stays rooted in place</span>
      <h1 id="heroTitle">Stay somewhere <em>with a story.</em></h1>
      <p class="lede">
        Cabins above the tree line, farmhouses at the end of a dirt road, apartments in the old quarter. Book
        directly with hosts who know their place, and pay securely online.
      </p>

      <form class="search-panel" action="/listings" method="GET" role="search" aria-label="Find a stay">
        <div class="search-field">
          <label for="heroSearch">Where</label>
          <input id="heroSearch" type="search" name="search" placeholder="City, country or stay" maxlength="100" />
        </div>
        <div class="search-field">
          <label for="heroCategory">Type of stay</label>
          <select id="heroCategory" name="category">
            <option value="">Anything</option>
            <% for (const item of categories) { %>
            <option value="<%= item.name %>"><%= item.name %></option>
            <% } %>
          </select>
        </div>
        <button class="btn btn-primary btn-lg" type="submit"><%- helpers.icon("search") %>Search</button>
      </form>

      <% if (stats && stats.stays) { %>
      <div class="hero-facts" aria-label="Travel Roots in numbers">
        <span><strong><%= stats.stays.toLocaleString("en-IN") %></strong>stays</span>
        <span><strong><%= stats.countries.toLocaleString("en-IN") %></strong><%= stats.countries === 1 ? "country" : "countries" %></span>
        <span><strong><%= stats.hosts.toLocaleString("en-IN") %></strong><%= stats.hosts === 1 ? "host" : "hosts" %></span>
      </div>
      <% } %>
    </div>

    <div class="hero-media">
      <img
        src="<%= helpers.asset('/images/hero-960.webp') %>"
        srcset="<%= heroSrcset %>"
        sizes="(min-width: 992px) 46vw, 100vw"
        width="960"
        height="768"
        alt="A wooden rowing boat on a green alpine lake below limestone peaks"
        fetchpriority="high"
      />
      <% if (featured) { %>
      <a class="hero-note" href="/listings/<%= featured._id %>">
        <span class="listing-card-kicker">Top rated right now</span>
        <strong><%= featured.title %></strong>
        <span class="text-muted"><%= helpers.placeName(featured.location, featured.country) %></span>
        &middot; <span class="rating"><%- helpers.icon("star") %><%= featured.ratingAverage.toFixed(1) %></span>
      </a>
      <% } %>
    </div>
  </section>
  <% } else { %>
  <section class="page-intro">
    <a href="/listings" class="back-link"><%- helpers.icon("arrow-left") %>All stays</a>
    <h1>
      <% if (search && category) { %><%= category %> stays matching "<%= search %>"<% } else if (search) { %>Stays matching "<%= search %>"<% } else if (category) { %><%= category %> stays<% } else { %>All stays<% } %>
    </h1>
  </section>
  <% } %>

  <nav class="categories" aria-label="Categories" id="stays">
    <a class="category-link <%= !category ? 'active' : '' %>" href="<%= buildQuery({ category: '', page: '' }) %>" <%- !category ? 'aria-current="true"' : '' %>>
      <%- helpers.icon("grid") %>All
    </a>
    <% for (const item of categories) { %>
    <a class="category-link <%= category === item.name ? 'active' : '' %>" href="<%= buildQuery({ category: item.name, page: '' }) %>" <%- category === item.name ? 'aria-current="true"' : '' %>>
      <%- helpers.icon(item.icon) %><%= item.name %>
    </a>
    <% } %>
  </nav>

  <div class="toolbar">
    <p class="result-count" aria-live="polite">
      <strong><%= total %></strong> <%= total === 1 ? "stay" : "stays" %>
      <% if (search || category) { %>&middot; <a href="/listings">Clear filters</a><% } %>
    </p>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="taxToggle" />
        <label class="form-check-label small" for="taxToggle">Prices incl. GST</label>
      </div>
      <form method="GET" action="/listings" class="d-flex align-items-center gap-2">
        <% if (search) { %><input type="hidden" name="search" value="<%= search %>" /><% } %>
        <% if (category) { %><input type="hidden" name="category" value="<%= category %>" /><% } %>
        <label for="sortSelect" class="small text-muted text-nowrap">Sort</label>
        <select id="sortSelect" name="sort" class="form-select" data-auto-submit>
          <% for (const [key, option] of Object.entries(sortOptions)) { %>
          <option value="<%= key %>" <%= key === sortKey ? "selected" : "" %>><%= option.label %></option>
          <% } %>
        </select>
        <noscript><button class="btn btn-sm btn-outline" type="submit">Apply</button></noscript>
      </form>
    </div>
  </div>

  <% if (listings.length) { %>
  <section aria-label="Stays">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 gy-5">
      <% listings.forEach((listing, index) => { %>
      <div class="col"><%- include("../includes/listing-card", { listing, eagerImage: !isLanding && index < 4 }) %></div>
      <% }) %>
    </div>
  </section>

  <% if (totalPages > 1) { %>
  <nav aria-label="Pagination">
    <ul class="pager">
      <li><a class="<%= page === 1 ? 'disabled' : '' %>" href="<%= buildQuery({ page: page - 1 > 1 ? page - 1 : '' }) %>" aria-label="Previous page"><%- helpers.icon("chevron-left") %></a></li>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <% if (p === 1 || p === totalPages || Math.abs(p - page) <= 1) { %>
        <li><a href="<%= buildQuery({ page: p > 1 ? p : '' }) %>" <%- p === page ? 'aria-current="page"' : '' %>><%= p %></a></li>
        <% } else if (Math.abs(p - page) === 2) { %>
        <li><span>&hellip;</span></li>
        <% } %>
      <% } %>
      <li><a class="<%= page === totalPages ? 'disabled' : '' %>" href="<%= buildQuery({ page: page < totalPages ? page + 1 : totalPages }) %>" aria-label="Next page"><%- helpers.icon("chevron-right") %></a></li>
    </ul>
  </nav>
  <% } %>
  <% } else { %>
  <div class="empty-state">
    <span class="empty-state-icon"><%- helpers.icon("map") %></span>
    <h2>Nothing here yet</h2>
    <p>We could not find a stay matching your search. Try another destination or browse every category.</p>
    <a href="/listings" class="btn btn-primary">Browse all stays</a>
  </div>
  <% } %>

  <% if (isLanding && destinations.length) { %>
  <section class="section" aria-labelledby="destinationsTitle">
    <div class="section-head">
      <div>
        <span class="eyebrow">Destinations</span>
        <h2 id="destinationsTitle">Where travellers are going</h2>
      </div>
      <a href="#stays" class="link-arrow">Browse every stay <%- helpers.icon("arrow-right") %></a>
    </div>
    <div class="destinations">
      <% destinations.forEach((destination, index) => { %>
      <a class="destination" href="/listings?search=<%= encodeURIComponent(destination._id) %>">
        <img
          src="<%= helpers.imageUrl(destination.image, index === 0 ? { width: 900, height: 1000 } : { width: 600, height: 450 }) %>"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="destination-label">
          <strong><%= destination._id %></strong>
          <span><%= destination.count %> <%= destination.count === 1 ? "stay" : "stays" %></span>
        </span>
      </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (isLanding) { %>
  <section class="section pt-0" aria-labelledby="principlesTitle">
    <div class="section-head">
      <div>
        <span class="eyebrow">How it works</span>
        <h2 id="principlesTitle">Booking, done properly</h2>
      </div>
    </div>
    <div class="principles">
      <article class="principle">
        <span class="principle-number">01</span>
        <h3>Prices you can trust</h3>
        <p>
          The nightly rate, GST and total are worked out on our servers before you pay. Razorpay handles your card
          details, so they never reach us.
        </p>
      </article>
      <article class="principle">
        <span class="principle-number">02</span>
        <h3>Reviews from real guests</h3>
        <p>Only signed-in guests can review, once per stay, and hosts cannot rate their own places.</p>
      </article>
      <article class="principle">
        <span class="principle-number">03</span>
        <h3>A host you can reach</h3>
        <p>
          Contact details are shown before you book, and every trip and receipt stays in your profile for later.
        </p>
      </article>
    </div>
  </section>

  <section class="host-band" aria-labelledby="hostTitle">
    <div>
      <span class="eyebrow text-reset">For hosts</span>
      <h2 id="hostTitle">Have a place worth sharing?</h2>
      <p>List a cabin, a spare room or a whole farm in a few minutes. You set the price, guests pay online.</p>
    </div>
    <a class="btn btn-lg" href="/listings/new">Host your place <%- helpers.icon("arrow-right") %></a>
  </section>
  <% } %>
</div>
