<% layout("/layouts/boilerplate") %>

<div class="container-xl">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
      <header class="pt-4 pb-3">
        <a href="/listings/<%= listing._id %>" class="small text-decoration-none"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Back to listing</a>
        <h1 class="h2 mt-2">Edit listing</h1>
        <p class="text-muted mb-0">Changes are visible to guests as soon as you save.</p>
      </header>
      <%- include("../includes/listing-form", { listing }) %>
    </div>
  </div>
</div>
