<% layout("/layouts/boilerplate") %>
<% block("head").append(`<link rel="stylesheet" href="${helpers.asset("/vendor/leaflet/leaflet.css")}" />`) %>
<% block("scripts").append(`<script src="${helpers.asset("/vendor/leaflet/leaflet.js")}" defer></script>`) %>
<% block("scripts").append(`<script src="${helpers.asset("/js/map.js")}" defer></script>`) %>
<%
  const listingId = listing._id.toString();
  const isSaved = saved.has(listingId);
  const host = listing.owner;
  const place = helpers.placeName(listing.location, listing.country);
  const coords = listing.coordinates && Number.isFinite(listing.coordinates.lat) ? listing.coordinates : { lat: 28.6139, lon: 77.209 };
  const imageSrc = listing.image && listing.image.url;
%>

<div class="container-xl">
  <header class="detail-head">
    <a href="/listings" class="back-link"><%- helpers.icon("arrow-left") %>All stays</a>
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
      <div>
        <h1><%= listing.title %></h1>
        <div class="meta-line">
          <% if (listing.ratingCount > 0) { %>
          <span class="rating"><%- helpers.icon("star") %><%= listing.ratingAverage.toFixed(1) %>&nbsp;<a href="#reviews"><%= listing.ratingCount %> <%= listing.ratingCount === 1 ? "review" : "reviews" %></a></span>
          <% } else { %>
          <span class="rating rating-new"><%- helpers.icon("star") %>New listing</span>
          <% } %>
          <span><%= place %></span>
          <span><%= listing.category %></span>
        </div>
      </div>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline" data-share data-share-title="<%= listing.title %> | Travel Roots" data-share-text="<%= listing.title %> in <%= place %>">
          <%- helpers.icon("share") %><span data-share-label>Share</span>
        </button>
        <% if (currUser && !isHost) { %>
        <button type="button" class="btn btn-outline save-toggle" data-wishlist-id="<%= listingId %>" aria-pressed="<%= isSaved ? 'true' : 'false' %>" aria-label="<%= isSaved ? 'Remove from saved stays' : 'Save to wishlist' %>">
          <%- helpers.icon("heart", { className: "icon-heart" }) %><span data-wishlist-label><%= isSaved ? "Saved" : "Save" %></span>
        </button>
        <% } %>
      </div>
    </div>
  </header>

  <div class="detail-gallery">
    <img
      src="<%= helpers.imageUrl(imageSrc, { width: 1400, height: 600 }) %>"
      srcset="<%= helpers.imageSrcset(imageSrc, [800, 1400, 2000], 21 / 9) %>"
      sizes="(min-width: 1320px) 1250px, 95vw"
      alt="<%= listing.title %>"
      width="1400"
      height="600"
      fetchpriority="high"
    />
  </div>

  <div class="row g-5 mt-0">
    <div class="col-lg-7">
      <section class="detail-section host-line">
        <%- include("../includes/avatar", { user: host, size: "md" }) %>
        <div>
          <h2>Hosted by <%= host ? (host.displayName || host.username) : "a former host" %></h2>
          <% if (host && host.createdAt) { %>
          <span class="small text-muted">Hosting since <%= new Intl.DateTimeFormat("en-IN", { month: "long", year: "numeric" }).format(host.createdAt) %></span>
          <% } %>
        </div>
      </section>

      <section class="detail-section" aria-labelledby="aboutTitle">
        <h2 id="aboutTitle">About this place</h2>
        <p class="prose mb-0"><%= listing.description %></p>
      </section>

      <section class="detail-section" aria-labelledby="factsTitle">
        <h2 id="factsTitle">At a glance</h2>
        <ul class="facts">
          <li><%- helpers.icon("tag") %><div><strong>Category</strong><span><%= listing.category %></span></div></li>
          <li><%- helpers.icon("map-pin") %><div><strong>Location</strong><span><%= place %></span></div></li>
          <li><%- helpers.icon("rupee") %><div><strong>Nightly rate</strong><span><%= helpers.formatINR(listing.price) %> plus GST</span></div></li>
          <li><%- helpers.icon("shield") %><div><strong>Payments</strong><span>Secured by Razorpay</span></div></li>
        </ul>
      </section>

      <section class="detail-section" aria-labelledby="mapTitle">
        <h2 id="mapTitle">Where you will be</h2>
        <p class="text-muted"><%= place %>. The exact address is shared after booking.</p>
        <div id="map" role="region" aria-label="Map showing the approximate location of this stay" data-lat="<%= coords.lat %>" data-lon="<%= coords.lon %>" data-label="<%= place %>"></div>
      </section>
    </div>

    <aside class="col-lg-5">
      <div class="surface reserve">
        <div class="d-flex justify-content-between align-items-baseline mb-3">
          <div><span class="reserve-price"><%= helpers.formatINR(listing.price) %></span> <span class="text-muted">per night</span></div>
          <% if (listing.ratingCount > 0) { %>
          <span class="rating"><%- helpers.icon("star") %><%= listing.ratingAverage.toFixed(1) %></span>
          <% } %>
        </div>

        <% if (isHost) { %>
        <p class="text-muted small">This is your listing. Guests see a reservation button here.</p>
        <div class="d-grid gap-2">
          <a href="/listings/<%= listingId %>/edit" class="btn btn-primary"><%- helpers.icon("pencil") %>Edit listing</a>
          <a href="/profile?tab=hosting" class="btn btn-outline">View reservations</a>
          <form method="POST" action="/listings/<%= listingId %>?_method=DELETE" data-confirm="Delete this listing permanently? Its reviews will also be removed.">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
            <button class="btn btn-danger-outline w-100" type="submit"><%- helpers.icon("trash") %>Delete listing</button>
          </form>
        </div>
        <% } else { %>
        <a href="/listings/<%= listingId %>/book" class="btn btn-primary btn-lg w-100">Check availability</a>
        <p class="small text-muted text-center mt-3 mb-0">
          Pick your dates on the next step. GST of <%= Math.round(taxRate * 100) %>% is added at checkout.
        </p>
        <% } %>
      </div>
    </aside>
  </div>

  <section class="detail-section" id="reviews" aria-labelledby="reviewsTitle">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <span class="eyebrow">Guest reviews</span>
        <% if (listing.ratingCount > 0) { %>
        <h2 id="reviewsTitle" class="review-score"><span class="display"><%= listing.ratingAverage.toFixed(1) %></span><span class="text-muted h6 mb-0">from <%= listing.ratingCount %> <%= listing.ratingCount === 1 ? "review" : "reviews" %></span></h2>
        <% } else { %>
        <h2 id="reviewsTitle" class="mb-0">No reviews yet</h2>
        <% } %>
      </div>
    </div>

    <% if (currUser && !isHost && !hasReviewed) { %>
    <div class="surface panel mb-4">
      <h3 class="h5 font-sans">Share your experience</h3>
      <form method="POST" action="/listings/<%= listingId %>/reviews" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
        <fieldset class="mb-3">
          <legend class="form-label mb-1">Your rating</legend>
          <div class="star-input">
            <% for (let value = 5; value >= 1; value--) { %>
            <input type="radio" id="rate<%= value %>" name="review[rating]" value="<%= value %>" <%= value === 5 ? "required" : "" %> />
            <label for="rate<%= value %>" title="<%= value %> star<%= value > 1 ? 's' : '' %>"><%- helpers.icon("star") %><span class="visually-hidden"><%= value %> star<%= value > 1 ? "s" : "" %></span></label>
            <% } %>
          </div>
        </fieldset>
        <div class="mb-3">
          <label for="reviewComment" class="form-label">Your review</label>
          <textarea id="reviewComment" name="review[comment]" class="form-control" rows="4" minlength="3" maxlength="1000" required placeholder="What did you enjoy? What could be better?"></textarea>
          <div class="invalid-feedback">Please write at least a few words.</div>
        </div>
        <button class="btn btn-primary" type="submit">Post review</button>
      </form>
    </div>
    <% } else if (!currUser) { %>
    <p class="text-muted"><a href="/login">Sign in</a> to leave a review after your stay.</p>
    <% } %>

    <% if (reviews.length) { %>
    <div class="reviews">
      <% for (const review of reviews) { %>
      <article class="review">
        <div class="review-head">
          <%- include("../includes/avatar", { user: review.author, size: "md", decorative: true }) %>
          <div class="flex-grow-1">
            <div class="fw-semibold"><%= review.author.displayName || review.author.username %></div>
            <div class="small text-muted"><%= helpers.formatDate(review.createdAt) %></div>
          </div>
          <% if (currUser && review.author._id.equals(currUser._id)) { %>
          <form method="POST" action="/listings/<%= listingId %>/reviews/<%= review._id %>?_method=DELETE" data-confirm="Delete your review?">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
            <button class="btn btn-ghost btn-icon" type="submit" aria-label="Delete your review"><%- helpers.icon("trash") %></button>
          </form>
          <% } %>
        </div>
        <%- include("../includes/stars", { rating: review.rating }) %>
        <p><%= review.comment %></p>
      </article>
      <% } %>
    </div>
    <% } else { %>
    <p class="text-muted mb-0">Guests who stay here can be the first to share their experience.</p>
    <% } %>
  </section>

  <% if (similar.length) { %>
  <section class="section pb-0" aria-labelledby="similarTitle">
    <div class="section-head">
      <h2 id="similarTitle">More <%= listing.category.toLowerCase() %> stays</h2>
      <a class="link-arrow" href="/listings?category=<%= encodeURIComponent(listing.category) %>">See all <%- helpers.icon("arrow-right") %></a>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
      <% for (const item of similar) { %>
      <div class="col"><%- include("../includes/listing-card", { listing: item }) %></div>
      <% } %>
    </div>
  </section>
  <% } %>
</div>
