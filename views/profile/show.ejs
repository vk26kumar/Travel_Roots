<% layout("/layouts/boilerplate") %>
<%
  const user = currUser;
  const statusLabels = { PENDING: "Awaiting payment", PAID: "Paid", CONFIRMED: "Confirmed", FAILED: "Payment failed", CANCELLED: "Cancelled" };
  const tabs = [
    { key: "trips", label: "Trips", count: upcoming.length + past.length },
    { key: "saved", label: "Saved", count: wishlist.length },
    { key: "listings", label: "Listings", count: listings.length },
    { key: "hosting", label: "Reservations", count: reservations.length },
    { key: "reviews", label: "Reviews", count: reviews.length },
  ];
  const memberSince = user.createdAt ? new Intl.DateTimeFormat("en-IN", { month: "long", year: "numeric" }).format(user.createdAt) : "";
%>

<div class="container-xl">
  <section class="profile-head" aria-labelledby="profileName">
    <%- include("../includes/avatar", { user, size: "lg" }) %>
    <div class="flex-grow-1">
      <span class="eyebrow">Your profile</span>
      <h1 id="profileName"><%= user.displayName || user.username %></h1>
      <div class="profile-meta">
        <span><%- helpers.icon("user") %>@<%= user.username %></span>
        <% if (user.location) { %><span><%- helpers.icon("map-pin") %><%= user.location %></span><% } %>
        <% if (memberSince) { %><span><%- helpers.icon("calendar") %>Member since <%= memberSince %></span><% } %>
        <% if (user.googleId) { %><span><%- helpers.icon("google") %>Google connected</span><% } %>
        <% if (user.githubId) { %><span><%- helpers.icon("github") %>GitHub connected</span><% } %>
      </div>
      <% if (user.bio) { %><p class="prose mt-3 mb-0"><%= user.bio %></p><% } %>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/profile/settings" class="btn btn-outline"><%- helpers.icon("pencil") %>Edit profile</a>
      <a href="/listings/new" class="btn btn-primary"><%- helpers.icon("plus") %>Host a place</a>
    </div>
  </section>

  <section class="figures" aria-label="Account summary">
    <div class="figure"><span class="value"><%= stats.upcoming %></span><span class="label">Upcoming trips</span></div>
    <div class="figure"><span class="value"><%= stats.trips %></span><span class="label">Total trips</span></div>
    <div class="figure"><span class="value"><%= stats.saved %></span><span class="label">Saved stays</span></div>
    <div class="figure"><span class="value"><%= stats.listings %></span><span class="label">Listings</span></div>
    <div class="figure"><span class="value"><%= helpers.formatINR(stats.totalSpent) %></span><span class="label">Spent on stays</span></div>
    <% if (stats.listings) { %>
    <div class="figure"><span class="value"><%= helpers.formatINR(stats.totalEarned) %></span><span class="label">Host earnings</span></div>
    <% } %>
  </section>

  <nav class="tabs" aria-label="Profile sections">
    <% for (const item of tabs) { %>
    <a href="/profile?tab=<%= item.key %>" class="<%= tab === item.key ? 'active' : '' %>" <%- tab === item.key ? 'aria-current="page"' : '' %>><%= item.label %><span class="count"><%= item.count %></span></a>
    <% } %>
  </nav>

  <% if (tab === "trips") { %>
  <section class="tab-section" aria-labelledby="upcomingTitle">
    <h2 id="upcomingTitle">Upcoming</h2>
    <% if (upcoming.length) { %>
    <div class="mb-5">
      <% for (const booking of upcoming) { %>
      <article class="trip">
        <img src="<%= helpers.imageUrl(booking.listing && booking.listing.image && booking.listing.image.url, { width: 300, height: 224 }) %>" alt="" loading="lazy" width="150" height="112" />
        <div>
          <span class="status status-<%= booking.status %>"><%= statusLabels[booking.status] %></span>
          <h3><%= booking.listing ? booking.listing.title : "Listing no longer available" %></h3>
          <% if (booking.listing) { %><p class="text-muted mb-1"><%= helpers.placeName(booking.listing.location, booking.listing.country) %></p><% } %>
          <p class="mb-0"><strong><%= helpers.formatDate(booking.fromDate) %></strong> to <strong><%= helpers.formatDate(booking.toDate) %></strong> &middot; <%= booking.nights %> <%= booking.nights === 1 ? "night" : "nights" %></p>
        </div>
        <div class="text-md-end">
          <div class="fw-semibold mb-2"><%= helpers.formatINR(booking.amount) %></div>
          <a href="/bookings/<%= booking._id %>" class="link-arrow">Receipt <%- helpers.icon("arrow-right") %></a>
        </div>
      </article>
      <% } %>
    </div>
    <% } else { %>
    <div class="empty-state mb-5">
      <span class="empty-state-icon"><%- helpers.icon("luggage") %></span>
      <h3>No upcoming trips</h3>
      <p>When you book a stay it will appear here, along with its receipt.</p>
      <a href="/listings" class="btn btn-primary">Find a stay</a>
    </div>
    <% } %>

    <% if (past.length) { %>
    <h2>Past and other bookings</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">Stay</th><th scope="col">Dates</th><th scope="col">Amount</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <% for (const booking of past) { %>
          <tr>
            <td><%= booking.listing ? booking.listing.title : "Listing no longer available" %></td>
            <td class="text-nowrap"><%= helpers.formatDate(booking.fromDate) %> to <%= helpers.formatDate(booking.toDate) %></td>
            <td><%= helpers.formatINR(booking.amount) %></td>
            <td><span class="status status-<%= booking.status %>"><%= statusLabels[booking.status] %></span></td>
            <td class="text-end"><a href="/bookings/<%= booking._id %>">Details</a></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
  <% } %>

  <% if (tab === "saved") { %>
  <section class="tab-section" aria-label="Saved stays">
    <% if (wishlist.length) { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 gy-5">
      <% for (const listing of wishlist) { %>
      <div class="col"><%- include("../includes/listing-card", { listing }) %></div>
      <% } %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <span class="empty-state-icon"><%- helpers.icon("heart") %></span>
      <h3>No saved stays yet</h3>
      <p>Tap the heart on any stay to keep it here for later.</p>
      <a href="/listings" class="btn btn-primary">Explore stays</a>
    </div>
    <% } %>
  </section>
  <% } %>

  <% if (tab === "listings") { %>
  <section class="tab-section" aria-label="Your listings">
    <% if (listings.length) { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 gy-5">
      <% for (const listing of listings) { %>
      <div class="col">
        <%- include("../includes/listing-card", { listing }) %>
        <div class="card-actions d-flex gap-2 mt-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline"><%- helpers.icon("pencil") %>Edit</a>
          <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-ghost">View</a>
        </div>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <span class="empty-state-icon"><%- helpers.icon("house-plus") %></span>
      <h3>You are not hosting yet</h3>
      <p>Share your place with travellers and earn on your own schedule.</p>
      <a href="/listings/new" class="btn btn-primary">Host your place</a>
    </div>
    <% } %>
  </section>
  <% } %>

  <% if (tab === "hosting") { %>
  <section class="tab-section" aria-label="Reservations">
    <% if (reservations.length) { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">Guest</th><th scope="col">Listing</th><th scope="col">Dates</th><th scope="col">Nights</th><th scope="col">Payout</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <% for (const booking of reservations) { %>
          <tr>
            <td><%= booking.user ? (booking.user.displayName || booking.user.username) : "Former guest" %></td>
            <td><%= booking.listing ? booking.listing.title : "" %></td>
            <td class="text-nowrap"><%= helpers.formatDate(booking.fromDate) %> to <%= helpers.formatDate(booking.toDate) %></td>
            <td><%= booking.nights %></td>
            <td><%= helpers.formatINR(booking.subtotal != null ? booking.subtotal : booking.amount) %></td>
            <td><span class="status status-<%= booking.status %>"><%= statusLabels[booking.status] %></span></td>
            <td class="text-end"><a href="/bookings/<%= booking._id %>">Details</a></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <p class="small text-muted mt-3">Payout is the accommodation amount before GST.</p>
    <% } else { %>
    <div class="empty-state">
      <span class="empty-state-icon"><%- helpers.icon("calendar-check") %></span>
      <h3>No reservations yet</h3>
      <p><%= listings.length ? "Confirmed bookings for your listings will appear here." : "Host a place to start receiving reservations." %></p>
      <% if (!listings.length) { %><a href="/listings/new" class="btn btn-primary">Host your place</a><% } %>
    </div>
    <% } %>
  </section>
  <% } %>

  <% if (tab === "reviews") { %>
  <section class="tab-section" aria-label="Your reviews">
    <% if (reviews.length) { %>
    <div class="reviews">
      <% for (const review of reviews) { %>
      <article class="review">
        <div class="d-flex justify-content-between gap-2">
          <div>
            <% if (review.listing && review.listingTitle) { %>
            <a href="/listings/<%= review.listing %>#reviews" class="fw-semibold"><%= review.listingTitle %></a>
            <% } else { %>
            <span class="fw-semibold">A stay</span>
            <% } %>
            <div class="small text-muted"><%= helpers.formatDate(review.createdAt) %></div>
          </div>
          <%- include("../includes/stars", { rating: review.rating }) %>
        </div>
        <p><%= review.comment %></p>
      </article>
      <% } %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <span class="empty-state-icon"><%- helpers.icon("star") %></span>
      <h3>No reviews yet</h3>
      <p>After a stay, share your experience to help other travellers.</p>
    </div>
    <% } %>
  </section>
  <% } %>
</div>
