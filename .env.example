# Copy this file to .env for local development. Never commit real values.

# ---------- Core ----------
NODE_ENV=development
PORT=8080
# Public base URL, used in password reset emails and OAuth callback defaults.
APP_URL=http://localhost:8080
# MongoDB connection string (MongoDB Atlas in production).
ATLASDB_URL=mongodb://127.0.0.1:27017/travelroots
# Session and cookie signing secret. Use a long random value (32+ characters).
SECRET=replace-with-a-long-random-string
# Number of reverse proxies in front of the app (1 on Render). Defaults to 1 in production.
# TRUST_PROXY=1

# ---------- Image uploads (Cloudinary) ----------
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
# CLOUD_FOLDER=Travel_Roots_DATA

# ---------- Geocoding (Geoapify) ----------
MAP_API_KEY=

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (password reset) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Travel Roots <no-reply@example.com>
SUPPORT_EMAIL=support@example.com
