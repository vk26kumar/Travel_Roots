{
  "name": "travel-roots",
  "version": "2.2.0",
  "description": "Travel Roots is a full-stack stay booking platform where hosts list unique places and guests discover, review and book them with secure online payments.",
  "main": "server.js",
  "private": true,
  "author": "Vishal Kumar",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/vk26kumar/Travel_Roots.git"
  },
  "homepage": "https://travel-roots.onrender.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --test-timeout=120000 --experimental-test-coverage \"tests/**/*.test.js\"",
    "demo": "node scripts/demo.js",
    "demo:watch": "node --watch-path=src --watch-path=scripts --watch-path=server.js scripts/demo.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "bootstrap": "^5.3.8",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "leaflet": "^1.9.4",
    "method-override": "^3.0.0",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^8.0.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
